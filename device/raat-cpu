#!/usr/bin/env bash
# mscOS: put RAATServer (Roon's audio endpoint) on the audio core, CPU1, next to the USB
# host-controller IRQs, like PipeWire/Soloist in Spotify mode.
#
# roonbridge.service keeps CPUAffinity=0 1: RoonBridge (.NET) waits only ~6 s for
# RAATServer to open port 9004 and kills it otherwise, and on one A20 core its start takes
# ~9 s. So the move happens after 9004 answers. All existing threads move (taskset -a);
# threads RAAT creates later inherit CPU1. RoonBridge may respawn RAATServer: the new
# process is picked up on the next check. RAAT raises its own audio threads to SCHED_FIFO
# (sched_setscheduler, logged in /var/roon/RAATServer/Logs); as root that succeeds, since
# RT_GROUP_SCHED is off. This only changes the CPU.
# Run by raat-cpu.service, which is bound to roonbridge.service.
moved=
while :; do
    pid=$(pgrep -x RAATServer | head -n1)
    if [[ -n $pid && $pid != "$moved" ]] && ss -Hltn 'sport = :9004' | grep -q .; then
        if taskset -a -p 2 "$pid" >/dev/null 2>&1; then
            moved=$pid
            echo "RAATServer $pid on CPU1 ($(ls /proc/"$pid"/task | wc -l) threads)"
        fi
    fi
    sleep 5
done
