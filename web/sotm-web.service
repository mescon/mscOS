[Unit]
Description=mscOS control panel (web/PWA)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/sotm-web/backend/app.py
Environment=SOTM_STATIC=/opt/sotm-web/static
Environment=SOTM_STATE=/var/lib/sotm-web
# This installation's settings (not in the repo): ARCAM_HOST, and for an HTTPS reverse proxy
# SOTM_PUBLIC_URL + SOTM_TRUSTED_PEERS. Without them: local mode on http://<hostname>.local.
EnvironmentFile=-/etc/mscos/site.env
# Secrets, root-only: HA_WEBHOOK_URL (Home Assistant alerts).
EnvironmentFile=-/etc/sotm-web.env
Restart=always
RestartSec=3
# Lowest CPU priority: the panel must never compete with audio.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
