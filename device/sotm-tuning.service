[Unit]
Description=Audio tuning for sMS-200Ultra (CPU/IRQ split, thermal polling off)
# After Armbian's own optimizer (it tries to move eth0's IRQ to CPU1 on sun7i).
After=armbian-hardware-optimize.service systemd-modules-load.service systemd-udev-settle.service
Before=user-runtime-dir@982.service user@982.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sotm-tuning

[Install]
WantedBy=multi-user.target
