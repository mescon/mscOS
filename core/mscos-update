#!/usr/bin/env bash
# Update mscOS itself from its releases: newer mscos-*.deb packages are downloaded from the
# project's release page (HOME_URL in /etc/mscos-release, a GitHub repository) and installed
# with apt, which also restarts the panel.
#   mscos-update --check    print {"current", "latest", "available", "signed"} as JSON, change nothing
#   mscos-update            install the latest release if it is newer
# A release is installed only when its SHA256SUMS carries the project's signature
# (SHA256SUMS.sig, checked by mscos-verify against the keys in /usr/share/mscos/keys) and
# every package matches it. MSCOS_ALLOW_UNSIGNED=1 in /etc/mscos/site.env is the device
# owner's way to install from a repository of their own without a key.
# MSCOS_RELEASES overrides the address of the release information (the GitHub API's
# releases/latest of another repository, for a fork).
set -euo pipefail
. /etc/mscos-release 2>/dev/null || true
[ -n "${MSCOS_ALLOW_UNSIGNED:-}" ] || MSCOS_ALLOW_UNSIGNED=$(sed -n 's/^MSCOS_ALLOW_UNSIGNED=//p' /etc/mscos/site.env 2>/dev/null | tail -1 || true)
VERIFY=$(dirname "$(readlink -f "$0")")/mscos-verify
CUR=${VERSION:-0}
REPO=$(printf '%s' "${HOME_URL:-}" | sed -n 's|^https://github.com/\([^/]*/[^/]*\)/*$|\1|p')
API=${MSCOS_RELEASES:-${REPO:+https://api.github.com/repos/$REPO/releases/latest}}
[ -n "$API" ] || { echo "No release address (HOME_URL in /etc/mscos-release)" >&2; exit 1; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
code=$(curl --proto '=https' --proto-redir '=https' --silent --show-error --location --retry 2 --max-time 30 -o "$tmp/rel.json" -w '%{http_code}' \
    -H 'Accept: application/vnd.github+json' "$API") || { echo "The release page could not be reached" >&2; exit 1; }
if [ "$code" = 404 ]; then
    [ "${1:-}" = --check ] && { printf '{"current": "%s", "latest": null, "available": false, "signed": false}\n' "$CUR"; exit 0; }
    echo "No release has been published yet."; exit 0
fi
[ "$code" = 200 ] || { echo "The release page answered $code" >&2; exit 1; }
TAG=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("tag_name",""))' "$tmp/rel.json")
LATEST=${TAG#v}
[ -n "$LATEST" ] || { echo "The release has no version" >&2; exit 1; }
NEWER=false
dpkg --compare-versions "$LATEST" gt "$CUR" && NEWER=true

# has the maintainer signed it yet? (the packages are built first, the signature follows)
SIGNED=$(python3 -c 'import json,sys
n = {a.get("name") for a in json.load(open(sys.argv[1])).get("assets", [])}
print("true" if {"SHA256SUMS", "SHA256SUMS.sig"} <= n else "false")' "$tmp/rel.json")
if [ "${1:-}" = --check ]; then
    printf '{"current": "%s", "latest": "%s", "available": %s, "signed": %s}\n' "$CUR" "$LATEST" "$NEWER" "$SIGNED"
    exit 0
fi
$NEWER || { echo "mscOS $CUR is the latest."; exit 0; }

# Only files of this repository's own release. The checksums come from the release's
# SHA256SUMS, which must carry the project's signature: the private key is not kept with the
# repository, so someone who has taken the repository over cannot publish a release that
# devices install. Without a signature the checksum GitHub recorded at upload is used only
# when the device's owner has allowed unsigned releases.
get() { curl --proto '=https' --proto-redir '=https' --fail --silent --show-error --location --retry 3 -o "$2" "$1"; }
SUMS=
if [ "$SIGNED" = true ] && [ -n "$REPO" ]; then
    get "https://github.com/$REPO/releases/download/$TAG/SHA256SUMS" "$tmp/SHA256SUMS"
    get "https://github.com/$REPO/releases/download/$TAG/SHA256SUMS.sig" "$tmp/SHA256SUMS.sig"
    if "$VERIFY" "$tmp/SHA256SUMS" "$tmp/SHA256SUMS.sig"; then SUMS=$tmp/SHA256SUMS; fi
fi
if [ -z "$SUMS" ] && [ "${MSCOS_ALLOW_UNSIGNED:-}" != 1 ]; then
    if [ "$SIGNED" = true ]; then echo "The signature of release $TAG is not the project's. Nothing was installed." >&2
    else echo "Release $TAG is not signed yet. Nothing was installed; try again later." >&2; fi
    exit 1
fi
[ -n "$SUMS" ] || echo "Unsigned release, allowed by MSCOS_ALLOW_UNSIGNED."
python3 - "$tmp/rel.json" "$REPO" "$SUMS" "$LATEST" > "$tmp/assets" <<'PY'
import json, re, sys
repo, sums, latest = sys.argv[2], {}, sys.argv[4]
if sys.argv[3]:
    for line in open(sys.argv[3]):
        m = re.fullmatch(r"([0-9a-f]{64})  ([\w.+~-]+)\n?", line)
        if m:
            sums[m.group(2)] = m.group(1)
for a in json.load(open(sys.argv[1])).get("assets", []):
    n, u, d = a.get("name", ""), a.get("browser_download_url", ""), a.get("digest") or ""
    if not re.fullmatch(r"mscos[a-z-]*_[0-9A-Za-z.+~-]+_all\.deb", n):
        continue
    # the signed list names each package with its version: only this release's own packages,
    # so the signature of an older release cannot be attached to a newer tag
    if n.split("_")[1] != latest:
        continue
    if repo and not u.startswith(f"https://github.com/{repo}/releases/download/"):
        continue
    m = re.fullmatch(r"sha256:([0-9a-f]{64})", d)
    want = sums.get(n) if sys.argv[3] else (m.group(1) if m else None)
    if u.startswith("https://") and want:
        print(n, u, want)
PY
debs=()
while read -r name url sum; do
    pkg=${name%%_*}
    dpkg -s "$pkg" >/dev/null 2>&1 || continue
    echo "Downloading $name…"
    curl --proto '=https' --proto-redir '=https' --fail --silent --show-error --location --retry 3 -o "$tmp/$name" "$url"
    echo "$sum  $tmp/$name" | sha256sum --check --status || { echo "$name does not match the checksum of the release. Nothing was installed." >&2; exit 1; }
    debs+=("$tmp/$name")
done < "$tmp/assets"
[ ${#debs[@]} -gt 0 ] || { echo "The release $TAG has no packages for this device." >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
echo "Installing mscOS $LATEST…"
apt-get install -y -q -o Dpkg::Options::=--force-confold "${debs[@]}"
echo "mscOS $LATEST is installed."
