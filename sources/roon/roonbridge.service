[Unit]
Description=Roon Bridge (RAAT endpoint for the USB DAC)
After=network-online.target mscos-tuning.service
Wants=network-online.target
# Not enabled: the panel's source switch starts it in Roon mode and stops it for Spotify,
# so that only one player at a time owns the DAC (Roon needs it directly for DSD).
Conflicts=shutdown.target

[Service]
Type=simple
User=root
Environment=ROON_DATAROOT=/var/roon
Environment=ROON_ID_DIR=/var/roon
ExecStart=/opt/RoonBridge/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
